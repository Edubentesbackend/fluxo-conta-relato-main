{
  "name": "mrkfin-financeiro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/src/index.ts",
    "build": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "prisma:seed": "tsx server/prisma/seed.ts",
    "supabase:export": "tsx server/prisma/scripts/export-supabase.ts",
    "supabase:import": "tsx server/prisma/scripts/import-supabase-export.ts",
    "test:api": "vitest run server/tests",
    "host:configure-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/configure-local-env.ps1",
    "host:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/backup-database.ps1",
    "host:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-host.ps1",
    "host:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start-host.ps1",
    "host:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/restart-host.ps1",
    "host:diagnose": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/diagnose-host.ps1",
    "host:install-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-startup-task.ps1",
    "host:configure-network": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/configure-host-network.ps1",
    "host:rotate-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/rotate-local-secrets.ps1"
  },
